<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 1. El Parent POM de Spring Boot: gestiona las versiones de todas las dependencias -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version> <!-- Usando una versión LTS estable y reciente -->
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<!-- 2. Coordenadas del Proyecto -->
	<groupId>com.edunekta</groupId>
	<artifactId>dev</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>dev-springboot</name>
	<description>Aplicación SENA migrada a Spring Boot</description>

	<!-- 3. Propiedades Centrales -->
	<properties>
		<java.version>17</java.version>
	</properties>

	<!-- 4. Dependencias de la Aplicación -->
	<dependencies>
		<!-- CORE STARTERS - La base de nuestra aplicación -->

		<!-- Para la capa web: Spring MVC, REST y servidor Tomcat embebido. -->
		<!-- Reemplaza: FacesServlet, servlets manuales y el empaquetado WAR. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Para la persistencia con JPA e Hibernate. -->
		<!-- Reemplaza: EJB Facades, persistence.xml y EntityManager manual. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Para la capa de seguridad. -->
		<!-- Reemplaza: Filtro.java, SecurityUtil.java y la seguridad manual en sesión. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Motor de plantillas Thymeleaf para las vistas. -->
		<!-- Reemplaza: JSF (JavaServer Faces) y archivos .xhtml. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Integración de Thymeleaf con Spring Security (para sec:authorize). -->
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!-- Para la validación de DTOs con anotaciones (jakarta.validation). -->
		<!-- Reemplaza: javax.validation y la validación manual en los beans. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- BASE DE DATOS -->

		<!-- Conector JDBC para MySQL. -->
		<!-- Reemplaza: La configuración del DataSource en glassfish-resources.xml. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- HERRAMIENTAS DE DESARROLLO -->

		<!-- Para reducir código repetitivo (getters, setters, constructores, etc.). -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Proporciona reinicios automáticos y live-reload para un desarrollo más rápido. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- LIBRERÍAS ADICIONALES (Mantenidas del POM moderno) -->

		<!-- Para envío de correos, una funcionalidad común. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Las siguientes dependencias son para funcionalidades como generación de reportes (CSV, PDF,
		Gráficos). -->
		<!-- Se mantienen porque estaban en el POM objetivo. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-csv</artifactId>
			<version>1.10.0</version>
		</dependency>
		<dependency>
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>1.3.30</version>
		</dependency>

		<!-- TESTING -->

		<!-- Starter principal para tests con JUnit 5, Mockito y AssertJ. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Utilidades para testear endpoints protegidos por Spring Security. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- 5. Configuración del Build -->
	<build>
		<plugins>
			<!-- Plugin esencial para empaquetar la aplicación como un JAR ejecutable. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Necesario para que Lombok funcione correctamente con Spring Boot -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>